# Feishu / Lark app credentials (开发者后台 → 凭证与基础信息)
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=
# feishu (飞书, default) or lark (international)
FEISHU_DOMAIN=feishu

# LLM keys referenced from config/roles.yaml via ${VAR}
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
PRIVATE_LLM_KEY=

# Runtime
# Built-in scenario (recommended for 需求小助手): requirements
# BOT_SCENARIO=requirements
# Or point BOT_CONFIG at a custom YAML (overrides BOT_SCENARIO)
BOT_CONFIG=/app/config/roles.yaml
BOT_DB_PATH=/data/bot.db
LOG_LEVEL=INFO

# Optional: bot open_id (auto-detected via /open-apis/bot/v3/info when empty)
FEISHU_BOT_OPEN_ID=

# Runtime dashboard (运行看板, same process). Disabled when DASHBOARD_TOKEN is empty.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# File the dashboard writes secret overrides to (default .env in the working dir)
# BOT_ENV_FILE=.env
